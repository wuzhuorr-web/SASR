---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PreviewNotice from '../components/PreviewNotice.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  activePath: string;
}
const { title, description, activePath } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123b4b" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'inner-page': activePath !== '/' }}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader activePath={activePath} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <PreviewNotice />
  </body>
</html>
